@model FirstResponsiveWebAppLastName.Models.UserModel
@{
    ViewData["Title"] = "First Responsive Web App";
}

<h2>First Responsive Web App</h2>

<form asp-action="Index" method="post">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" style="color:blue"></span>
    </div>

    <div>
        <label asp-for="BirthYear"></label>
        <input asp-for="BirthYear" />
        <span asp-validation-for="BirthYear"style="color:blue"></span>
    </div>

    <div>
        <button type="submit">Submit</button>

        <button type="button">Clear</button>
    </div>
</form>

